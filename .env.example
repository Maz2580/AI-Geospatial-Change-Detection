# Required only for the `nearmap` command. Never commit your real .env file.
NEARMAP_API_KEY=

# Optional Encroachment candidate source. These stay local and are never stored in outputs.
UMAMI_BASE_URL=https://geollm.idigitaltwin.org/TEST-UMAMI
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Retained for the existing DINOv2/SAM experimental scripts.
HF_TOKEN=

# Optional vision-model review of change candidates (src/review_candidates_visually.py).
# Any OpenAI-compatible vision endpoint works; swap --base-url and --model to change provider.
NVIDIA_API_KEY=
